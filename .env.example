# Copy this file to .env (same folder) and fill in your own keys. Never commit or share .env.
# Do not put spaces around "=".

# ---- Pick ONE way to run the agents and the AI judge (the judge is always a different model) ----
# Way 1: AWS Builder Center sandbox  -> Claude Sonnet 4.6 on Amazon Bedrock, judge Amazon Nova Pro (no AWS keys needed there)
# Way 2: your own Anthropic API key  -> Claude Opus 5.5, judge Claude Sonnet 5.5 (paid)
# Free wiring check                  -> MODEL_PROVIDER=dryrun (no model is called)
MODEL_PROVIDER=bedrock
JUDGE_PROVIDER=bedrock
AWS_REGION=us-east-1

# Way 2 only - https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Arize AX (step 4) - app.arize.com -> Space settings -> API keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Braintrust (step 5) - braintrust.dev -> Settings -> API keys
BRAINTRUST_API_KEY=

# Optional: Groq free tier for a few-case trial (MODEL_PROVIDER=groq, JUDGE_PROVIDER=groq) - console.groq.com/keys
GROQ_API_KEY=
